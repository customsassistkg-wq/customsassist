# --- Зависимости -----------------------------------------------------------
node_modules/

# --- Секреты ---------------------------------------------------------------
# Реальные значения (DATABASE_URL, SESSION_SECRET, RESEND_API_KEY) живут
# только на VPS; в репозитории лежит только server/.env.example как образец.
.env
server/.env

# --- Кэш, который приложение скачивает само --------------------------------
# server/data/class-decisions.json — 22 МБ выгрузки справочника №1999 НСИ ЕАЭС,
# обновляется services/classDecisions.js раз в сутки и восстанавливается сам.
server/data/

# --- Разовые выводы команд деплоя и отладки от прошлых сессий ---------------
backend_logs*.txt
compose_ps.txt
rebuild_result.txt
redeploy*.txt
setup_result*.txt
verify*.txt

# --- Служебное состояние наблюдателя за публикациями ЕЭК --------------------
.eec_watch_state.json

# --- Локальные настройки Claude Code ---------------------------------------
.claude/settings.local.json
