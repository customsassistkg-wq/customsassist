DATABASE_URL=postgres://tnved_app:changeme@127.0.0.1:5432/tnved
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3000
NODE_ENV=production
APP_ORIGIN=https://your-domain.example
# Дашборд администраторов на отдельном имени (блок dash.* в nginx.conf, страница
# server/dash/index.html, код — /api/dash.js только администратору). Origin
# добавляется к разрешённым автоматически; вход на этом имени открыт только
# администраторам. Пустое значение — дашборд не опубликован.
DASH_ORIGIN=https://dash.your-domain.example

# Cloudflare Turnstile (captcha on registration and password reset).
# Both keys come from the Cloudflare dashboard: Turnstile -> Add widget.
# Turnstile does NOT require the domain to be proxied through Cloudflare;
# DNS-only records are fine, only the account matters.
#
# Leave TURNSTILE_SECRET_KEY empty and the captcha is simply off: the widget
# is not rendered and nothing is verified, so the app runs exactly as it did
# before. Filling both in and restarting the service turns it on.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Обращения: приём входящей почты от Cloudflare Email Worker (POST /api/mail/inbound).
# Тот же секрет задаётся в Worker переменной INBOUND_SECRET; без него маршрут отвечает 503,
# и Worker просто пересылает письма на почту владельца. Ответы уходят с адреса поддержки.
MAIL_INBOUND_SECRET=
# MAIL_SUPPORT_FROM=Customs Assist KG <info@customsassist.trade>

# Уведомления администраторам в Telegram (services/telegram.js): сбои, перебор базы, расход AI,
# обращения, оплаты, регистрации, дозор источников. Токен — от @BotFather; chat id — через
# node scripts/telegram-chat-id.js после «Старт» в боте. Пусто — выключено, письма уходят как раньше.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=

# Разбор находок дозора из Telegram (routes/ops.js, docs/ops-routine.md). Без них команды боту выключены.
# TELEGRAM_WEBHOOK_SECRET — 32–256 знаков A-Z a-z 0-9 _ - (openssl rand -hex 24); ставится
#   node scripts/telegram-webhook.js set. OPS_REPORT_SECRET — секрет отчёта рутины и чтения
#   официальных сайтов (/api/ops/fetch); тот же — в переменных окружения рутины на claude.ai.
# ROUTINE_FIRE_URL и ROUTINE_TOKEN — адрес и токен API-триггера рутины (токен вводит
#   server/ops/set-routine-token.sh).
TELEGRAM_WEBHOOK_SECRET=
OPS_REPORT_SECRET=
ROUTINE_FIRE_URL=
ROUTINE_TOKEN=

# Оплата подписки по QR через xPay (routes/pay.js). Пустой XPAY_CLIENT_ID — оплата выключена:
# кнопок нет, истёкшая подписка — прежний отказ. Боевые ключи — в личном кабинете lk.xpay.kg,
# раздел «Профиль»; XPAY_API без значения — тестовая среда https://devapi.xpay.kg.
XPAY_CLIENT_ID=
XPAY_CLIENT_SECRET=
# XPAY_API=https://api.xpay.kg
# XPAY_SERVICE_UUID=

# AI-помощник (/api/assistant). Модель DeepSeek через API, совместимый с
# Anthropic. Пустой AI_API_KEY — помощник выключен (503), остальное работает.
# Ключ хранится только здесь, в .env на сервере: в страницу и в git он не попадает.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/anthropic
# Имена моделей: deepseek-flash (DeepSeek-V4.1-Flash, принимает изображения) и deepseek-v4-pro
# (дороже, изображения не принимает). Старые deepseek-chat и deepseek-reasoner объявлены
# прекращёнными с 24.07.2026 и в перечне GET /models их уже нет — не задавать их заново.
AI_MODEL=deepseek-flash
# Порядок чтения страниц документов. По умолчанию сначала Европа: текст даёт Google Vision
# (регион ЕС), документ по нему восстанавливает модель, и изображение в КНР не уходит; модели
# изображение отправляется только при недоверии к тексту (цифры кодов ненадёжны, текста почти нет).
# AI_READ_EU=0 возвращает прежний порядок — страницу сразу читает модель по изображению.
AI_READ_EU=1
# Лимиты вопросов по тарифам в день и в месяц (base входит в подписку); по умолчанию 3/100, 20/300, 60/1000.
# AI_PLAN_LIMITS={"base":{"day":3,"month":100},"pro":{"day":20,"month":300},"max":{"day":60,"month":1000}}
# Суточный потолок расхода помощника по всем пользователям, $ (сутки Бишкека): выше него вопросы и чтение
# страниц получают 503 до полуночи, администраторам уходит письмо. По умолчанию 10; 0 — без потолка.
# AI_DAILY_BUDGET_USD=10
# Цены DeepSeek, $ за 1 млн токенов в часы пик (вне пика — половина); по умолчанию — на 16.09.2026.
# AI_PRICES={"flash":{"cacheHit":0.006,"cacheMiss":0.30,"output":1.20},"pro":{"cacheHit":0.044,"cacheMiss":1.32,"output":3.96}}
